# Empezá siempre en homologación.
ARCA_ENV=homo
# CUIT sintético válido para dry-run. Reemplazalo únicamente al conectar tu cuenta.
ARCA_CUIT=20000000001
ARCA_PUNTO_VENTA=1
ARCA_CERT_PATH=./secrets/homo/arca-homo.crt
ARCA_KEY_PATH=./secrets/homo/arca-homo.key
ARCA_TICKET_PATH=./tickets/homo
ARCA_USE_HTTPS_AGENT=false

# Datos del emisor para el PDF.
ARCA_EMISOR_RAZON_SOCIAL=Contribuyente de prueba
ARCA_EMISOR_DOMICILIO=Domicilio de prueba
ARCA_EMISOR_CONDICION_IVA=Monotributo
ARCA_EMISOR_IIBB=-
ARCA_EMISOR_INICIO_ACTIVIDADES=20200101
ARCA_EMISOR_CONTACTO=

# API local. Dejala enlazada a loopback.
ARCA_SERVICE_HOST=127.0.0.1
ARCA_SERVICE_PORT=8787
ARCA_SERVICE_TOKEN=
